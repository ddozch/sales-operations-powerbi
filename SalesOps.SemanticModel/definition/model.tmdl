model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		fastCombine
		legacyRedirects

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","fnReadCsv","fnParseUtc","fnUtcToWarsaw","fnLocalDate","stgExportInfo","stgUsers","stgAccounts","stgProducts","stgOrders","rawOrderLines","stgOrderLines","rawInstallations","stgInstallations","stgOrderFacts","Date","Customer","Owner","Product","Crew","Orders","Order Lines","Installations","DQ Fields","DQ Checks","Snapshot","_Measures"]

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Functions

	annotation PBI_QueryGroupOrder = 1

queryGroup Staging

	annotation PBI_QueryGroupOrder = 2

ref table _Measures
ref table Date
ref table Customer
ref table Owner
ref table Product
ref table Crew
ref table Orders
ref table 'Order Lines'
ref table Installations
ref table 'DQ Fields'
ref table 'DQ Checks'
ref table Snapshot
