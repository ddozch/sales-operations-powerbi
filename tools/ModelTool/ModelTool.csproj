<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 is the LTS release; RollForward lets the exe run on a newer major runtime too -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The client libraries ship resources in 40 languages; English is enough -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.118.3" />
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient" Version="19.118.3" />
  </ItemGroup>

</Project>
